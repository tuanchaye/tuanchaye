---
import '../styles/global.css';
import { getUI } from '../i18n/ui';
import { LOCALES, LOCALE_NAMES, type Locale, DEFAULT_LOCALE } from '../i18n/config';
import { stripLocale, withLocale } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  wide?: boolean;
  locale?: Locale; // 公开页面传入；不传则为英文后台（不显示切换器）
  canonicalPath?: string; // 用于 hreflang，默认取当前路径去掉语言前缀
}
const { title, description, wide = false, locale, canonicalPath } = Astro.props;
const loc: Locale = locale ?? DEFAULT_LOCALE;
const ui = getUI(loc);
const site = 'https://tuanchaye.com';
const can = canonicalPath ?? stripLocale(Astro.url.pathname || '/');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      // 站名必须是纯品牌名（不带宣传语），Google SERP 的站点名称取自这里
      name: 'TuanChaYe',
      alternateName: ['团茶叶', 'TuanChaYe Tea'],
      url: site,
      potentialAction: {
        '@type': 'SearchAction',
        target: `${site}/en/search?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      name: 'TuanChaYe',
      url: site,
      // Google 品牌头像兜底数据源（Organization logo，须 ≥112px 正方形）
      logo: `${site}/favicon-512.png`,
    },
  ],
};
---
<!doctype html>
<html lang={loc}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title.includes('TuanChaYe') ? title : `${title} | TuanChaYe`}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta property="og:site_name" content="TuanChaYe" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- 规范地址：与最终 200 URL（无尾斜杠）一致，避免斜杠变体重复收录 -->
    <link rel="canonical" href={`${site}${withLocale(loc, can)}`} />
    <!-- favicon 套图：Google 要求 ≥48px，ico 兜底老抓取器 -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <!-- hreflang 多语言 SEO -->
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={`${site}${withLocale(l, can)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${site}${withLocale(DEFAULT_LOCALE, can)}`} />
  </head>
  <body>
    <header>
      <a href={withLocale(loc, '/')} class="logo">团茶叶 · TuanChaYe</a>
      <nav>
        <a href={withLocale(loc, '/')}>{ui.nav.home}</a>
        <a href={withLocale(loc, '/posts')}>{ui.nav.articles}</a>
        <a href={withLocale(loc, '/about')}>{ui.nav.about}</a>
        <a href={withLocale(loc, '/contact')}>{ui.nav.contact}</a>
      </nav>
      <form class="search-form" action={withLocale(loc, '/search')} method="get" role="search">
        <input
          type="search"
          name="q"
          placeholder={ui.search.placeholder}
          aria-label={ui.search.aria}
        />
        <button type="submit" aria-label={ui.search.aria}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </form>
      {locale && (
        <div class="lang-switch" data-current={loc}>
          <label class="lang-label" for="lang-select">{ui.languageLabel}</label>
          <select id="lang-select" class="lang-select" aria-label={ui.languageLabel}>
            {LOCALES.map((l) => (
              <option value={l} selected={l === loc}>{LOCALE_NAMES[l]}</option>
            ))}
          </select>
        </div>
      )}
    </header>
    <main class={wide ? 'wide' : ''}>
      <slot />
    </main>
    <footer>
      <p>{ui.footer.replace('{year}', String(new Date().getFullYear()))}</p>
    </footer>
    {locale && (
      <script is:inline define:vars={{ currentLocale: loc }}>
        (function () {
          var sel = document.getElementById('lang-select');
          if (!sel) return;
          sel.addEventListener('change', function () {
            var target = sel.value;
            var path = window.location.pathname;
            var parts = path.split('/');
            // 去掉已有的语言前缀
            if (parts[1] && ['en','zh','es','fr','de','ja','pt','ru'].indexOf(parts[1]) !== -1) {
              parts.splice(1, 1);
            }
            var can = parts.join('/');
            if (can === '' || can === '/') can = '/';
            var next = '/' + target + (can === '/' ? '/' : can);
            document.cookie = 'tealang=' + target + ';path=/;max-age=31536000;samesite=lax';
            window.location.pathname = next;
          });
        })();
      </script>
    )}
  </body>
</html>
