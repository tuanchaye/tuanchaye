---
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
const site = 'https://tuanchaye.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TuanChaYe - Chinese Tea Knowledge',
  url: site,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${site}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <header>
      <a href="/" class="logo">团茶叶 · TuanChaYe</a>
      <form class="search-form" action="/search" method="get" role="search">
        <input
          type="search"
          name="q"
          placeholder="Search articles…"
          aria-label="Search articles"
        />
        <button type="submit" aria-label="Search">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </form>
      <nav>
        <a href="/">Home</a>
        <a href="/posts">Articles</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>
    <main class={wide ? 'wide' : ''}>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} TuanChaYe · Chinese Tea Knowledge for Global Readers</p>
    </footer>
  </body>
</html>
