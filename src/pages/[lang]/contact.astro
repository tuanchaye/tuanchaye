---
import Layout from '../../layouts/Layout.astro';
import { getUI } from '../../i18n/ui';
import { CONTACT } from '../../i18n/pages';
import { LOCALES, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const ui = getUI(lang);
const c = CONTACT[lang];
---
<Layout title={`${ui.nav.contact} · TuanChaYe`} description={c.body[0]} locale={lang} canonicalPath="/contact">
  <div class="page-hero">
    <h1>{ui.nav.contact}</h1>
  </div>
  {c.body.map((p) => <p>{p}</p>)}
  <div class="section-ornament" aria-hidden="true">&#x2767;</div>
  <p class="meta">{c.note}</p>
</Layout>
