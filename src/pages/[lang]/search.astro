---
import Layout from '../../layouts/Layout.astro';
import { getUI } from '../../i18n/ui';
import { LOCALES, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const ui = getUI(lang);
---
<Layout title={`${ui.searchPage.title} · TuanChaYe`} description={ui.searchPage.placeholder} locale={lang} canonicalPath="/search">
  <h1>{ui.searchPage.title}</h1>
  <p class="meta">{ui.searchPage.placeholder}</p>
  <div id="search"></div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline define:vars={{ ph: ui.searchPage.placeholder, nr: ui.searchPage.noResult }}>
    window.addEventListener('DOMContentLoaded', function () {
      if (typeof window.PagefindUI === 'undefined') return;
      new window.PagefindUI({
        element: '#search',
        showSubResults: true,
        queryParam: 'q',
        translations: {
          placeholder: ph,
          zero_results: nr,
        },
      });
    });
  </script>
</Layout>
