---
import Layout from '../../../layouts/Layout.astro';
import { getPostsForLocale } from '../../../lib/posts';
import { getUI } from '../../../i18n/ui';
import { LOCALES, type Locale } from '../../../i18n/config';
import { withLocale } from '../../../i18n/utils';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const ui = getUI(lang);
const posts = (await getPostsForLocale(lang)).sort(
  (a, b) => b.pubDate.valueOf() - a.pubDate.valueOf()
);
---
<Layout
  title={`${ui.postsList.title} · TuanChaYe`}
  description={ui.postsList.description}
  wide={true}
  locale={lang}
  canonicalPath="/posts"
>
  <h1>{ui.postsList.title}</h1>
  <ul class="post-list">
    {
      posts.map((p) => (
        <li class="post-row">
          <a class="post-thumb" href={withLocale(lang, `/posts/${p.base}`)}>
            <img src={p.cover} alt={p.title} width="240" height="135" loading="lazy" />
          </a>
          <div class="post-info">
            <a class="post-title" href={withLocale(lang, `/posts/${p.base}`)}>{p.title}</a>
            <p class="meta">{p.description}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Layout>
