---
import Layout from '../../layouts/Layout.astro';
import { getPostsForLocale, sortPostViews } from '../../lib/posts';
import { CATEGORIES, canonicalCategory, getCategoryLocalized } from '../../lib/categories';
import { getUI } from '../../i18n/ui';
import { LOCALES, type Locale } from '../../i18n/config';
import { withLocale } from '../../i18n/utils';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const ui = getUI(lang);

const posts = sortPostViews(await getPostsForLocale(lang));

// 每个规范分类取最新发布的一篇作为入口文章
const latestByCat = new Map<string, (typeof posts)[number]>();
for (const p of posts) {
  const slug = canonicalCategory(p.category);
  if (!latestByCat.has(slug)) latestByCat.set(slug, p);
}
---
<Layout
  title={`TuanChaYe - ${ui.hero.title}`}
  description={ui.hero.subtitle}
  wide={true}
  locale={lang}
  canonicalPath="/"
>
  <section class="hero">
    <h1>{ui.hero.title}</h1>
    <p>{ui.hero.subtitle}</p>
  </section>

  <section class="cat-section">
    <h2>{ui.home.browseByCategory}</h2>
    <div class="cat-grid">
      {
        CATEGORIES.map((cat) => {
          const t = getCategoryLocalized(cat.slug, lang);
          const latest = latestByCat.get(cat.slug);
          return (
            <div class="cat-card">
              <a
                class="cat-banner"
                href={withLocale(lang, `/category/${cat.slug}`)}
                style={`background-image:linear-gradient(rgba(0,0,0,.32),rgba(0,0,0,.58)), url(${cat.cover});background-size:cover;background-position:center;`}
              >
                <span class="cat-banner-name">{t.name}</span>
              </a>
              <div class="cat-body">
                <p class="cat-desc">{t.description}</p>
                {latest && (
                  <div class="cat-featured">
                    <span class="cat-featured-label">{ui.home.latest}</span>
                    <a class="cat-featured-title" href={withLocale(lang, `/posts/${latest.base}`)}>
                      {latest.title}
                    </a>
                    <p class="cat-featured-excerpt">{latest.description}</p>
                  </div>
                )}
                <a class="cat-more" href={withLocale(lang, `/category/${cat.slug}`)}>
                  {ui.home.browseAll} {t.name} &rarr;
                </a>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <div class="section-ornament" aria-hidden="true">&#x2767;</div>

  <p class="meta" style="text-align: center;">
    {ui.home.newGuides} <a href={withLocale(lang, '/posts')}>{ui.home.viewAll} &rarr;</a>
  </p>
</Layout>
