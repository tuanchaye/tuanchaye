---
import Layout from '../../layouts/Layout.astro';
import { getUI } from '../../i18n/ui';
import { PRIVACY, CONTACT } from '../../i18n/pages';
import { LOCALES, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const ui = getUI(lang);
const pr = PRIVACY[lang];
---
<Layout title={`Privacy Policy · TuanChaYe`} description={`Privacy Policy for TuanChaYe.`} locale={lang} canonicalPath="/privacy">
  <div class="page-hero">
    <h1>Privacy Policy</h1>
  </div>
  <p>{pr.updated}</p>
  {pr.sections.map((s) => (
    <>
      <h2>{s.h}</h2>
      <p>{s.p}</p>
    </>
  ))}
  <div class="section-ornament" aria-hidden="true">&#x2767;</div>
  <p class="meta">{CONTACT[lang].note}</p>
</Layout>
