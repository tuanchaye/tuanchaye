---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout
  title="TuanChaYe - Chinese Tea Knowledge for Global Readers"
  description="Discover Chinese tea: types, brewing methods, culture and buying guides. Written for tea lovers worldwide."
>
  <h1>Chinese Tea Knowledge, Made Simple</h1>
  <p>
    TuanChaYe (团茶叶) is a Chinese-tea knowledge platform for global readers.
    Explore tea types, brewing guides, culture and how to choose your tea.
  </p>

  <h2>Latest Articles</h2>
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <a href={`/posts/${p.slug}`}>{p.data.title}</a>
        <p class="meta">{p.data.description}</p>
      </li>
    ))}
  </ul>
</Layout>
