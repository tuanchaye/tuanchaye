---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, canonicalCategory } from '../lib/categories';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 每个规范分类取最新发布的一篇作为入口文章
const latestByCat = new Map<string, (typeof posts)[number]>();
for (const p of posts) {
  const slug = canonicalCategory(p.data.category);
  if (!latestByCat.has(slug)) latestByCat.set(slug, p);
}
---

<Layout
  title="TuanChaYe - Chinese Tea Knowledge for Global Readers"
  description="Discover Chinese tea: types, brewing methods, culture and buying guides. Written for tea lovers worldwide."
>
  <section class="hero">
    <h1>Chinese Tea Knowledge, Made Simple</h1>
    <p>
      TuanChaYe (团茶叶) is a Chinese-tea knowledge platform for global readers.
      Explore tea types, brewing guides, culture and how to choose your tea.
    </p>
  </section>

  <section class="cat-section">
    <h2>Browse by Category</h2>
    <div class="cat-grid">
      {
        CATEGORIES.map((cat) => {
          const latest = latestByCat.get(cat.slug);
          return (
            <div class="cat-card">
              <a
                class="cat-banner"
                href={`/category/${cat.slug}`}
                style={`background-image:linear-gradient(rgba(0,0,0,.32),rgba(0,0,0,.58)), url(${cat.cover});background-size:cover;background-position:center;`}
              >
                <span class="cat-banner-name">{cat.name}</span>
              </a>
              <div class="cat-body">
                <p class="cat-desc">{cat.description}</p>
                {latest && (
                  <div class="cat-featured">
                    <span class="cat-featured-label">Latest</span>
                    <a class="cat-featured-title" href={`/posts/${latest.slug}`}>
                      {latest.data.title}
                    </a>
                    <p class="cat-featured-excerpt">{latest.data.description}</p>
                  </div>
                )}
                <a class="cat-more" href={`/category/${cat.slug}`}>
                  Browse all {cat.name} &rarr;
                </a>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <div class="section-ornament" aria-hidden="true">&#x2767;</div>

  <p class="meta" style="text-align: center;">
    New guides are added regularly. <a href="/posts">View all articles &rarr;</a>
  </p>
</Layout>
