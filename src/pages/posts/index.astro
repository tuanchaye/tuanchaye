---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { postCover } from '../../lib/categories';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Articles · TuanChaYe"
  description="All Chinese tea articles on TuanChaYe: tea types, brewing guides and tea culture."
>
  <h1>Articles</h1>
  <ul class="post-list">
    {
      posts.map((p) => (
        <li class="post-row">
          <a class="post-thumb" href={`/posts/${p.slug}`}>
            <img src={postCover(p.data.category, p.data.cover)} alt={p.data.title} width="240" height="135" loading="lazy" />
          </a>
          <div class="post-info">
            <a class="post-title" href={`/posts/${p.slug}`}>{p.data.title}</a>
            <p class="meta">{p.data.description}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Layout>
